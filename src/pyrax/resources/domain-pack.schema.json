{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyrax.dev/schemas/domain-pack.schema.json",
  "title": "Pyrax Domain Pack",
  "type": "object",
  "required": ["id", "name", "version", "problem", "sources", "entities", "signals", "decisions", "evidence", "outcomes", "guardrails"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "problem": {
      "type": "object",
      "required": ["decision_to_improve", "decision_owner", "allowed_actions"],
      "properties": {
        "decision_to_improve": {"type": "string", "minLength": 1},
        "decision_owner": {"type": "string", "minLength": 1},
        "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "sources": {"type": "array", "minItems": 1},
    "entities": {"type": "array", "minItems": 1},
    "relationships": {"type": "array", "items": {"type": "object"}},
    "ontology": {"type": "object"},
    "decision_graph": {"type": "object"},
    "scenarios": {"type": "array"},
    "operational_grain": {"type": "string"},
    "states": {"type": "array", "items": {"type": "string"}},
    "timestamps": {"type": "array", "items": {"type": "string"}},
    "semantics": {
      "type": "object",
      "properties": {
        "certified": {"type": "array", "items": {"type": "string"}},
        "candidates": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "signals": {"type": "array", "minItems": 1},
    "decisions": {"type": "array", "minItems": 1},
    "evidence": {"type": "object", "minProperties": 1},
    "confidence": {"type": "object"},
    "approval_policy": {"type": "object"},
    "guardrails": {"type": "array", "minItems": 1},
    "outcomes": {"type": "array", "minItems": 1},
    "maturity": {"type": "object"},
    "qa": {"type": "object"},
    "implementation": {"type": "object"},
    "ux": {"type": "object"}
  },
  "additionalProperties": true
}
