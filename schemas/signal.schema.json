{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyrax.dev/schemas/signal.schema.json",
  "title": "Pyrax Signal",
  "type": "object",
  "required": ["id", "rule", "evidence_required"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "rule": {"type": "string", "minLength": 1},
    "severity": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence_policy": {"type": ["string", "object"]},
    "unknown_behavior": {"type": ["string", "object"]},
    "prohibited_interpretations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
