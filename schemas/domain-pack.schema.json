{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyrax.dev/schemas/domain-pack.schema.json",
  "title": "Pyrax Domain Pack",
  "type": "object",
  "required": ["id", "name", "version", "problem", "sources", "entities", "signals", "decisions", "evidence", "outcomes", "guardrails"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "problem": {
      "type": "object",
      "required": ["decision_to_improve", "decision_owner", "allowed_actions"],
      "properties": {
        "decision_to_improve": {"type": "string", "minLength": 1},
        "decision_owner": {"type": "string", "minLength": 1},
        "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "system", "authority", "access_mode", "grain"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "system": {"type": "string", "minLength": 1},
          "authority": {"enum": ["SYSTEM_OF_RECORD", "REFERENCE", "DERIVED", "EXTERNAL"]},
          "access_mode": {"type": "string", "minLength": 1},
          "grain": {"type": "string", "minLength": 1},
          "freshness": {"type": ["string", "null"]}
        }
      }
    },
    "entities": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "key"]}},
    "relationships": {"type": "array", "items": {"type": "object"}},
    "operational_grain": {"type": "string"},
    "states": {"type": "array", "items": {"type": "string"}},
    "timestamps": {"type": "array", "items": {"type": "string"}},
    "semantics": {
      "type": "object",
      "properties": {
        "certified": {"type": "array", "items": {"type": "string"}},
        "candidates": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "signals": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "rule", "evidence_required"]}},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "triggered_by", "recommendation"]}},
    "evidence": {"type": "object", "minProperties": 1},
    "confidence": {"type": "object"},
    "approval_policy": {"type": "object"},
    "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["metric", "success_condition"]}},
    "qa": {
      "type": "object",
      "properties": {
        "golden_cases": {"type": "integer", "minimum": 0},
        "contract_tests": {"type": "boolean"},
        "reconciliation_tests": {"type": "boolean"}
      }
    },
    "implementation": {
      "type": "object",
      "properties": {
        "runtime": {"type": "boolean"},
        "integration_tests": {"type": "boolean"},
        "deployment": {"type": "boolean"},
        "technology_profile": {"type": "string"}
      }
    },
    "ux": {"type": "object"}
  },
  "additionalProperties": true
}
