{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyrax.dev/schemas/recommendation.schema.json",
  "title": "Pyrax Recommendation",
  "type": "object",
  "required": ["decision_id", "action", "confidence", "evidence", "human_approval_required"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["CERTIFIED", "ASSISTED", "INSUFFICIENT_DATA"]},
    "evidence": {"type": "array", "minItems": 1},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "human_approval_required": {"type": "boolean"},
    "reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
